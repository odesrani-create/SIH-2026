# Supabase project settings
# Create these in your Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side AI settings (Vercel Environment Variables)
# NEVER expose OPENAI_API_KEY as a VITE_ variable or commit the real key.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
